{
  "name": "@iris-credit/test",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./vitest": {
      "types": "./lib/esm/vitest.d.ts",
      "import": "./lib/esm/vitest.js",
      "require": "./lib/cjs/vitest.js"
    },
    "./fixtures": {
      "types": "./lib/esm/fixtures.d.ts",
      "import": "./lib/esm/fixtures.js",
      "require": "./lib/cjs/fixtures.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/esm/index.d.ts",
        "import": "./lib/esm/index.js",
        "require": "./lib/cjs/index.js"
      },
      "./vitest": {
        "types": "./lib/esm/vitest.d.ts",
        "import": "./lib/esm/vitest.js",
        "require": "./lib/cjs/vitest.js"
      },
      "./fixtures": {
        "types": "./lib/esm/fixtures.d.ts",
        "import": "./lib/esm/fixtures.js",
        "require": "./lib/cjs/fixtures.js"
      }
    }
  },
  "scripts": {
    "prepublish": "$npm_execpath build",
    "build": "tsgo --noEmit && $npm_execpath build:cjs && $npm_execpath build:esm",
    "build:cjs": "tsgo --build tsconfig.build.cjs.json && echo '{\"type\":\"commonjs\"}' > lib/cjs/package.json",
    "build:esm": "tsgo --build tsconfig.build.esm.json && echo '{\"type\":\"module\"}' > lib/esm/package.json"
  },
  "dependencies": {
    "viem-deal": "^2.0.3",
    "viem-tracer": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "viem": "^2.21.10",
    "vitest": ">=2.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
