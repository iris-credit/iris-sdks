{
  "name": "iris-sdks",
  "private": true,
  "description": "Collection of SDKs to ease interactions with the IRIS credit",
  "license": "MIT",
  "author": "IRIS Team <team@iris.credit>",
  "contributors": [
    "u-zzam (https://github.com/u-zzam)",
    "madiha-right (https://github.com/madiha-right)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iris-credit/iris-sdks.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --if-present --workspace-concurrency=1 build",
    "clean": "rm -rf dist",
    "test": "dotenv -- turbo run test",
    "lint": "oxlint",
    "lint:address": "node scripts/lint/checksum-address.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.0",
    "typescript": "^7.0.0",
    "viem": "^2.55.8",
    "vitest": "^4.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "oxfmt",
      "node scripts/lint/checksum-address.js"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
